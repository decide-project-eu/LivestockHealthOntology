<http://aims.fao.org/aos/agrovoc/c_34495> a owl:Class ;
    rdfs:label "PasteurellaHaemolytica"@en ;
    NCIT:IAO_0000412 "https://agrovoc.fao.org/browse/agrovoc/en/" ;
    :hasExactSynonym "PH" ;
    rdfs:comment "Former name of Mannheimia haemolytica (reclassified in 1999); kept because existing data may use either name."@en,
        "Pasteurella haemolytica is a Gram-negative bacterium associated with respiratory infections, particularly in cattle, causing bovine respiratory disease complex (BRDC) or shipping fever."@en ;
    rdfs:isDefinedBy "https://agrovoc.fao.org/browse/agrovoc/en/page/c_34495" ;
    rdfs:subClassOf :PathogenicBacterium ;
    skos:altLabel "Pasteurella haemolytica"@ar,
        "Pasteurella haemolytica"@de,
        "Pasteurella haemolytica"@en,
        "pasteurella haemolytica"@en,
        "Pasteurella haemolytica"@es,
        "Pasteurella haemolytica"@nl,
        "Pasteurella haemolytica"@sv .

<http://aims.fao.org/aos/agrovoc/c_6145> a owl:Class ;
    rdfs:label "Poultry"@en ;
    NCIT:IAO_0000412 "https://agrovoc.fao.org/browse/agrovoc/en/page/c_6145" ;
    rdfs:comment "All domesticated birds used for the production of meat or eggs for consumption, for the production of other commercial products, for restocking, supplies of game, or for breeding these categories of birds." ;
