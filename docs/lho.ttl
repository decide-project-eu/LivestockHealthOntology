        "Ganado bovino"@es,
        "rund"@nl,
        "nötkreatur"@sv,
        "گائے"@ur .

<http://www.purl.org/decide#Event> a owl:Class ;
    rdfs:label "Event" ;
    NCIT:IAO_0000119 "http://www.purl.org/decide#Event" ;
    :imported_from "https://bioportal.bioontology.org/ontologies/DECIDE?p=classes" ;
    rdfs:comment "A class representing any occurrence or activity related to aquaculture or livestock management, such as disease outbreaks, treatments, movements, or inspections." ;
    rdfs:subClassOf :LivestockHealthOntology .

<http://www.purl.org/decide#Measurement> a owl:Class ;
    NCIT:IAO_0000412 "https://bioportal.bioontology.org/ontologies/DECIDE?p=summary" ;
    rdfs:comment "A record of an observed or measured value related to a specific characteristic (such as weight, age, or temperature) of an animal, population, environment, or system, applicable to both terrestrial livestock and aquaculture species" ;
    rdfs:subClassOf :LivestockHealthOntology ;
    skos:altLabel "قياس"@ar,
        "Abmessen"@de,
        "Eichen"@de,
        "Größenbestimmung"@de,
        "Messen"@de,
        "Messung"@de,
        "gauging"@en,
        "measuring"@en,
        "mensuration"@en,
        "size determination"@en,
        "Medición"@es,
        "mätning"@sv .

<http://www.purl.org/decide#SpeciesGroup> a owl:Class ;
    NCIT:IAO_0000412 "https://bioportal.bioontology.org/ontologies/DECIDE?p=summary" ;
    rdfs:comment """SpeciesGroup represents a group of animals belonging to the same species or production category 
    (e.g., Atlantic salmon, broiler chickens, weaned piglets, dairy cattle). 
    It is used to describe the target population involved in events such as sampling, treatment, or observation.""" ;
    owl:equivalentClass :Species .

<http://www.purl.org/decide#Veterinarian> a owl:Class ;
    NCIT:IAO_0000412 "https://bioportal.bioontology.org/ontologies/DECIDE?p=summary" ;
    rdfs:comment """A Veterinarian is a qualified and licensed professional responsible for the health and welfare of animals. 
    Veterinarians perform clinical examinations, diagnose diseases, prescribe treatments, and provide guidance on prevention, vaccination, and biosecurity in livestock and aquaculture settings.""" ;
    rdfs:subClassOf :LivestockHealthOntology ;
    skos:altLabel "أطباء بيطريون"@ar,
        "Tierarzt"@de,
        "Veterinär"@de,
        "veterinarians"@en,
        "veterinary surgeons"@en,
        "Veterinario"@es,
        "veterinärer"@sv ;
    skos:exactMatch <http://aims.fao.org/aos/agrovoc/c_8203> .

<http://www.purl.org/decide/LiveStockHealthOnto/LHO> a owl:Ontology ;
    NCIT:IAO_0000117 "Saba Noor" ;
    dc:contributor """Saba Noor
Miel Hostens""" ;
    :hasExactSynonym "LHO"@en ;
    rdfs:comment "LHO integrates domain knowledge and data for livestock health. The ontology covers farms, samples, geolocation, breed, diagnostic tests, and pathogen identification, including bacteria like Histophilus somni, Mannheimia haemolytica, Pasteurella multocida, Bovine coronavirus, bacterial mycoplasma, and aerobic culture results in cattle. For pigs, it includes FarmType, age, weight, and pathogens like PRRS, SI and M_Hyponemoniea. In poultry, LHO incorporates FarmType, with specific pathogen names such as Infectious Bronchitis (IB), providing a concise overview of health aspects across livestock species."@en,
        "https://www.purl.org/decide/LiveStockHealthOnto/LHO"@en ;
    rdfs:seeAlso """An extension of DECIDE ontology

https://bioportal.bioontology.org/ontologies/DECIDE?p=summary""",
        "https://bioportal.bioontology.org/ontologies/LHO"@en ;
    owl:priorVersion "V1.1"@en,
        "V1.3"@en,
        "V1.4"@en ;
    owl:versionIRI <http://www.purl.org/decide/LiveStockHealthOnto/LHO/1.5> ;
    owl:versionInfo "V1.5"@en ;
    skos:altLabel "أنطولوجيا صحة الماشية"@ar,
        "صحة الماشية"@ar,
        "Ontologie voor veegezondheid"@nl,
        "Veegezondheidsontologie"@nl,
        "veegezondheid"@nl,
        "مویشیوں کی صحت"@ur,
        "مویشیوں کی صحت کی آنٹولوجی"@ur ;
    skos:prefLabel "Livestock Health Ontology"@en .

