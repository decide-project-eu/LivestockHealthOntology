:BirthEvent a owl:Class ;
    rdfs:label "BirthEvent"@en ;
    NCIT:IAO_0000119 "Birth event refers to the occurrence of a living being coming into the world." ;
    rdfs:comment "Birth event refers to the occurrence of a living being coming into the world."@en ;
    rdfs:subClassOf <http://www.purl.org/decide#EventType> ;
    skos:altLabel "birth event"@en .

:Blood a owl:Class ;
    rdfs:comment "Blood is a SampleType. A blood sample is a specimen collected from an organism, typically through venipuncture, and is used for diagnostic or research purposes, providing insights into the health and physiological parameters of the individual."@en ;
    rdfs:subClassOf <http://www.purl.org/decide#SampleType> ;
    skos:altLabel "دم"@ar,
        "Blut"@de,
        "Sangre"@es ;
    skos:closeMatch <http://aims.fao.org/aos/agrovoc/c_959> .

:BreedingFarm a owl:Class ;
    rdfs:comment "A BreedingFarm may focus on breeding and raising animals for specific traits."@en ;
    rdfs:subClassOf :FarmType .

