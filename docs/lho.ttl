    rdfs:comment "A unit of time representing 12 months, often used for annual summaries or long-term analysis." ;
    rdfs:subClassOf :TimeUnit .

:affectsSpecies a owl:ObjectProperty ;
    rdfs:label "affectsSpecies"@en ;
    rdfs:comment "Links a pathogen, breed, sample type, or country to the species it applies to. Used to filter species-specific categories in a multi-species ontology."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range :Species .

:breed a owl:DatatypeProperty ;
    rdfs:comment "data type that Represents breed like beef, mixed, Veal, suckler" ;
    rdfs:domain <http://www.purl.org/decide#Sample> ;
    rdfs:range xsd:string .

:causesDisease a owl:ObjectProperty ;
    rdfs:label "causesDisease"@en ;
    rdfs:comment "Links a pathogen to the type of disease it causes. Used to classify pathogens into Viral or Bacterial groups for graph construction."@en ;
    rdfs:domain <http://www.purl.org/decide#Pathogen> ;
    rdfs:range <http://opendata.inra.fr/AHOL/AHOL_0005001> .

:country a owl:DatatypeProperty ;
    rdfs:comment "Data type Country naming type string" ;
    rdfs:domain NCIT:NCIT_C25464 ;
    rdfs:range xsd:string .

:hasAge a owl:ObjectProperty ;
    rdfs:comment "link a sample to age Unit" ;
    rdfs:domain <http://www.purl.org/decide#Sample> ;
    rdfs:range :Age .

:hasCountry a owl:ObjectProperty ;
    rdfs:comment "Sample belong to which country" ;
    rdfs:domain <http://www.purl.org/decide#Sample> ;
    rdfs:range NCIT:NCIT_C25464 .

:hasDate a owl:ObjectProperty ;
    rdfs:comment "animal sample date" ;
    rdfs:domain <http://www.purl.org/decide#Sample> ;
    rdfs:range :Date .

:hasDiagnosticTest a owl:ObjectProperty ;
    rdfs:comment "Links a sample to a test performed." ;
    rdfs:domain <http://www.purl.org/decide#Sample> ;
    rdfs:range :DiagnosticTest .

:hasEventType a owl:ObjectProperty ;
    rdfs:comment "link sample to event at which it perform" ;
    rdfs:domain <http://www.purl.org/decide#Sample> ;
    rdfs:range <http://www.purl.org/decide#EventType> .

:hasExactSynonym a owl:AnnotationProperty ;
    rdfs:comment "Exact synonyms are words that have completely identical or nearly identical meanings in given contexts" .

:hasFarmIdentification a owl:ObjectProperty ;
    rdfs:comment "Links a sample or a farm to unique farm ID" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.purl.org/decide#Farm> <http://www.purl.org/decide#Sample> ) ] ;
    rdfs:range :FarmIdentification .

:hasFarmType a owl:ObjectProperty ;
    rdfs:comment "link sample to the farm type" ;
    rdfs:domain <http://www.purl.org/decide#Sample> ;
    rdfs:range :FarmType .

:hasFinishingDate a owl:DatatypeProperty ;
    rdfs:label "hasFinishingDate"@en ;
    rdfs:comment "Date on which cattle entered the finishing stage." ;
    rdfs:domain :CattleSample ;
    rdfs:range xsd:date .

:hasGeographicNeighbor a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "hasGeographicNeighbor"@en ;
    rdfs:comment "Symmetric property indicating two countries share a geographic land border. Used to create geographic adjacency edges in the knowledge graph."@en ;
    rdfs:domain NCIT:NCIT_C25464 ;
    rdfs:range NCIT:NCIT_C25464 .

:hasLabReference a owl:ObjectProperty ;
    rdfs:comment "Link Lab reference,for identification and tracking within a laboratory or data system if Farm Identification is not available" ;
    rdfs:domain <http://www.purl.org/decide#Sample> ;
    rdfs:range :LabReference .

:hasPathogen a owl:ObjectProperty ;
    rdfs:comment "link sample to specific pathogen" ;
    rdfs:domain <http://www.purl.org/decide#Sample> ;
    rdfs:range <http://www.purl.org/decide#Pathogen> .

:hasProductionStages a owl:ObjectProperty ;
    rdfs:label "hasProductionStages"@en ;
    rdfs:comment "Links a sample to the production stage of the animal or group it was taken from, for example Nursery, Finishing or Broiler."@en ;
    rdfs:domain <http://www.purl.org/decide#Sample> ;
    rdfs:range :LivestockProductionStages .

:hasProvince a owl:ObjectProperty ;
    rdfs:comment "link sample to region" ;
    rdfs:domain <http://www.purl.org/decide#Sample> ;
    rdfs:range :Province .

:hasResult a owl:ObjectProperty ;
    rdfs:label "hasResult"@en ;
    rdfs:comment "Links a sample to its test result, positive (1) or negative (0). This is the property used in the RDF data of the Cattle, Pig and Poultry Barometers. It is a subproperty of hasSampleResult."@en ;
    rdfs:domain <http://www.purl.org/decide#Sample> ;
    rdfs:subPropertyOf :hasSampleResult .

:hasSampleNumber a owl:ObjectProperty ;
    rdfs:comment "link sample to its unique sample Number if available" ;
    rdfs:domain <http://www.purl.org/decide#Sample> ;
    rdfs:range :SampleNumber .

:hasSampleType a owl:ObjectProperty ;
    rdfs:comment "Associates a Sample with a SampleType indicating the kind of material collected, such as blood, tissue, feces, or water." ;
    rdfs:domain <http://www.purl.org/decide#Sample> ;
    rdfs:range <http://www.purl.org/decide#SampleType> .

:hasTimeUnit a owl:ObjectProperty ;
    rdfs:comment "Linking Animal age with TimeUnit",
        "Time unit like Months, days, minutes etc..." ;
    rdfs:domain :Age ;
    rdfs:range :TimeUnit .

:hasWeaningDate a owl:DatatypeProperty ;
    rdfs:label "hasWeaningDate"@en ;
    rdfs:comment "Date on which a calf was weaned." ;
    rdfs:domain :CattleSample ;
    rdfs:range xsd:date .

:hasWeight a owl:ObjectProperty ;
    rdfs:comment "link animal sample weight" ;
    rdfs:domain <http://www.purl.org/decide#Sample> ;
    rdfs:range :Weight .

:hasWeightUnit a owl:ObjectProperty ;
    rdfs:comment """A unit of measurement used to express the weight or mass of an animal, feed, or product. 
Common examples include kilogram (kg), gram (g), and tonne (t)."""@en ;
    rdfs:domain :Weight ;
    rdfs:range :WeightUnit .

:imported_from a owl:AnnotationProperty ;
    rdfs:comment "resource from where ontology is imported" .

:pathogen a owl:DatatypeProperty ;
    rdfs:comment "A data property that discribes  a name of the pathogen in animal sample" ;
    rdfs:domain <http://www.purl.org/decide#Pathogen> ;
    rdfs:range xsd:string .

:version a owl:AnnotationProperty ;
    rdfs:comment "version of ontology" ;
    rdfs:subPropertyOf rdfs:comment .

owl:equivalentClass a owl:AnnotationProperty .

skos:altLabel a owl:AnnotationProperty .

skos:closeMatch a owl:AnnotationProperty .

skos:exactMatch a owl:AnnotationProperty .

skos:prefLabel a owl:AnnotationProperty .

<http://aims.fao.org/aos/agrovoc/c_16398> a owl:Class ;
