:CattleFinishing a owl:Class ;
    rdfs:label "CattleFinishing"@en ;
    rdfs:comment "Finishing is the final production stage in which cattle are fed to reach market weight prior to slaughter." ;
    rdfs:subClassOf :CattleProductionStages ;
    skos:altLabel "تسمين"@ar,
        "Ausmast"@de,
        "Mast"@de,
        "cattle finishing"@en,
        "fattening"@en,
        "Ceba"@es,
        "Engorde"@es,
        "gödning"@sv ;
    skos:closeMatch <http://aims.fao.org/aos/agrovoc/c_2817> .

:CattleGrowing a owl:Class ;
    rdfs:label "CattleGrowing"@en ;
    rdfs:comment "Growing is an intermediate stage of beef cattle production, occurring after weaning and before finishing, during which animals continue to gain weight and develop." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom :Beef ;
            owl:onProperty :hasBreed ],
        :CattleProductionStages ;
    skos:altLabel "cattle growing"@en .

:CattleSuckling a owl:Class ;
    rdfs:label "CattleSuckling"@en ;
    rdfs:comment "The suckling stage refers to the period during which a calf remains with and nurses from its dam prior to weaning." ;
    rdfs:subClassOf :CattleProductionStages ;
    skos:altLabel "رضاعة"@ar,
        "Säugen"@de,
        "cattle suckling"@en,
        "suckling"@en,
        "Lactancia"@es,
        "Lactancia natural"@es ;
    skos:closeMatch <http://aims.fao.org/aos/agrovoc/c_7493> .

:CattleWeaning a owl:Class ;
    rdfs:label "CattleWeaning"@en ;
    rdfs:comment "Weaning is the stage at which a calf is separated from its dam and transitions from nursing to independent feeding." ;
    rdfs:subClassOf :CattleProductionStages ;
    skos:altLabel "فطام"@ar,
        "Absetzen"@de,
        "cattle weaning"@en,
        "weaning"@en,
        "Destete"@es ;
    skos:closeMatch <http://aims.fao.org/aos/agrovoc/c_15291> .

