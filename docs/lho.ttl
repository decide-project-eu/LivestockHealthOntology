        "gris"@sv,
        "grisar"@sv,
        "svin"@sv,
        "سؤر"@ur ;
    skos:closeMatch NCIT:NCBITaxon_9823 .

NCIT:IAO_0000027 a owl:Class ;
    rdfs:label "measurement datum" ;
    NCIT:IAO_0000412 "obo:IAO_0000119  \"http://purl.obolibrary.org/obo/iao.owl\" ." ;
    rdfs:comment "An information content entity that specifies how a realizable entity is concretized, and that is not concretized in the specification itself." ;
    rdfs:subClassOf :LivestockHealthOntology .

NCIT:IAO_0000112 a owl:AnnotationProperty ;
    rdfs:label "example of usage" ;
    rdfs:comment "A string that provides a usage example of a class, property, or other ontology element to help users understand how it is applied." .

NCIT:IAO_0000117 a owl:AnnotationProperty ;
    rdfs:label "term editor" ;
    NCIT:IAO_0000112 "For example, in the context of cattle, breeds can be categorized as meat, dairy, or mixed breeds, each breed for specific agricultural or culinary purposes. Similarly, in the context of poultry, breeds can be categorized as meat breeds or egg-laying breeds. Pigs are also breed for meat production. The 'Breed' class serves as a foundational concept for classifying and organizing various animal breeds within the ontology." ;
    rdfs:comment "The person primarily responsible for the creation or curation of a given ontology term." .

NCIT:IAO_0000118 a owl:AnnotationProperty ;
    rdfs:label "alternative term" ;
    rdfs:comment "A term or phrase that may be used as a synonym or alternate label for a given ontology entity, especially useful for searching and term matching." .

NCIT:IAO_0000119 a owl:AnnotationProperty ;
    rdfs:label "definition source" ;
    rdfs:comment "A reference (such as a publication, URL, or ontology) that identifies where the definition of a term originated from." .

NCIT:IAO_0000412 a owl:AnnotationProperty ;
    rdfs:label "imported from" ;
    rdfs:comment "An annotation indicating the source ontology or resource from which a given term was imported." .

dc:contributor a owl:AnnotationProperty ;
    rdfs:comment "Person who contribute to the ontology" .

dcterms:isReplacedBy a owl:AnnotationProperty .

<http://www.ncbi.nlm.nih.gov/taxonomy/9913> a owl:Class ;
