:SampleNumber a owl:Class ;
    rdfs:label "SampleNumber"@en ;
    rdfs:comment "SampleNumber is a unique identifier assigned to a specimen collected from livestock or other sources for purposes such as diagnostics or research, facilitating individual sample tracking and data organization."@en ;
    rdfs:subClassOf :LivestockHealthOntology ;
    skos:altLabel "sample number"@en .

:ShetlandIslands a :LocalAuthority,
        owl:NamedIndividual ;
    rdfs:comment "An individual representing different Local Authorities in UK."@en .

:Suckling a owl:Class ;
    rdfs:comment """Suckling stage begins at birth and lasts for about 21–28 days (3–4 weeks), during which piglets nurse from the sow.
They are born small (2–3 pounds), blind, and hairless but quickly develop eyesight, teeth, and mobility.
By around 3 weeks, they begin nibbling on solid feed alongside milk as they prepare for weaning.""" ;
    rdfs:subClassOf :PigProductionStages ;
    skos:altLabel "رضاعة"@ar,
        "Säugen"@de,
        "Lactancia"@es,
        "Lactancia natural"@es ;
    skos:closeMatch <http://aims.fao.org/aos/agrovoc/c_7493> .

:Swab a <http://www.purl.org/decide#SampleType>,
        owl:Class,
        owl:NamedIndividual ;
    :affectsSpecies :Cattle,
        :Pig ;
    rdfs:comment "individual for diagnostic test",
        "A swab is a sample collection method involving a small absorbent tool, often a cotton-tipped applicator, used to collect specimens from surfaces or body areas, such as the throat or nasal cavity, for diagnostic or research purposes."@en ;
    rdfs:subClassOf <http://www.purl.org/decide#SampleType> ;
    skos:altLabel "swab sample"@en .

:Weaning a :PigProductionStages,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:comment "Weaning stage (4–8 weeks) is when piglets are separated from the sow and transition fully to solid food, ending milk consumption." ;
    rdfs:subClassOf :PigProductionStages ;
    skos:altLabel "فطام"@ar,
        "Absetzen"@de,
        "Destete"@es ;
    skos:closeMatch <http://aims.fao.org/aos/agrovoc/c_15291> .

:WeightUnit a owl:Class ;
    rdfs:comment "A measurement unit used to quantify mass or weight, such as grams, kilograms, or pounds." ;
    rdfs:subClassOf <http://www.purl.org/decide#Unit> .

