    skos:altLabel "دواجن"@ar,
        "طيور مدجنة"@ar,
        "Geflügel"@de,
        "domestizierter Vogel"@de,
        "domesticated birds"@en,
        "poultry"@en,
        "Ave de corral"@es,
        "Aves domesticas"@es .

<http://aims.fao.org/aos/agrovoc/c_7555> a owl:Class ;
    rdfs:label "Pig"@en ;
    NCIT:IAO_0000412 "https://aims.fao.org/aos/agrovoc/c_7555.html" ;
    rdfs:comment "The pig (Sus domesticus), often called swine, hog, or domestic pig" ;
