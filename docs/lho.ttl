:CS10 a owl:DatatypeProperty ;
    rdfs:label "hasProvincePathogenPrevalence"@en ;
    rdfs:comment "data type vlaue Represents the prevalence rate of a pathogen in a province." ;
    rdfs:domain :Province ;
    rdfs:range xsd:float .

:CS11 a owl:DatatypeProperty ;
    rdfs:label "hasProvinceNoOfBRD"@en ;
    rdfs:comment "Count of BRD cases in a province." ;
    rdfs:domain :Province ;
    rdfs:range xsd:int .

:CS12 a owl:DatatypeProperty ;
    rdfs:label "hasCountryPathogenPrevalence"@en ;
    rdfs:comment "percentage % of cases in a country."@en ;
    rdfs:domain NCIT:NCIT_C25464 ;
    rdfs:range xsd:float .

:CS13 a owl:DatatypeProperty ;
    rdfs:label "hasCountryNoOfBRD"@en ;
    rdfs:comment "Count of positive  BRD cases in a country." ;
    rdfs:domain NCIT:NCIT_C25464 ;
    rdfs:range xsd:int .

:CS14 a owl:DatatypeProperty ;
    rdfs:label "hasQuarterPathogenPrevalence"@en ;
    rdfs:comment "% of cases in a quarter." ;
    rdfs:domain :CS20 ;
    rdfs:range xsd:float .

:CS15 a owl:DatatypeProperty ;
    rdfs:label "hasQuarterNoOfBRD"@en ;
    rdfs:comment "Count of BRD cases in Quarter" ;
    rdfs:domain :CS20 ;
    rdfs:range xsd:int .

:CS16 a owl:DatatypeProperty ;
    rdfs:label "result"@en ;
    rdfs:comment "A data property that tells whether a sample tested positive (1) or negative (0)." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.purl.org/decide#Sample> <http://www.purl.org/decide#SampleResult> ) ] ;
    rdfs:range xsd:string .

:CS17 a owl:DatatypeProperty ;
    rdfs:label "date"@en ;
    rdfs:comment "Date when the sample was collected." ;
    rdfs:domain <http://www.purl.org/decide#Sample> ;
    rdfs:range xsd:date .

:CS18 a owl:DatatypeProperty ;
    rdfs:label "hasSampleNumber"@en ;
    rdfs:comment "Unique ID for each sample." ;
    rdfs:domain <http://www.purl.org/decide#Sample> ;
    rdfs:range xsd:string .

:CS19 a :DiagnosticTest,
        owl:NamedIndividual ;
    rdfs:label "NPS"@en ;
    :affectsSpecies :Cattle ;
    :hasExactSynonym "Nasopharyngeal Swab"@en ;
    rdfs:comment "Nasopharyngeal Swab (NPS) is a sample collection method where a swab is inserted through the nostril to collect secretions from the nasopharynx. Commonly used for detecting respiratory pathogens" ;
    skos:altLabel "تقنیة تسـلسـل المسـام النانویة"@ar,
        "nanopore DNA sequencing"@en,
        "nanopore sequencing"@en,
        "Secuenciación de ADN a través de nanoporos"@es,
        "Secuenciación por nanoporos"@es .

:CS23 a owl:ObjectProperty ;
    rdfs:label "hasPrevalence"@en ;
    rdfs:comment "Links a region to pathogen prevalence." ;
    rdfs:domain NCIT:NCIT_C25341 ;
    rdfs:range <http://www.purl.org/decide#Pathogen> .

:CS24 a owl:ObjectProperty ;
    rdfs:label "hasBRDCase"@en ;
    rdfs:comment "Links a region to BRD case records."@en ;
    rdfs:domain NCIT:NCIT_C25341 ;
    rdfs:range :CS22 .

:CS25 a owl:ObjectProperty ;
    rdfs:label "hasTimePeriod"@en ;
    rdfs:comment "Links a region to a specific time period." ;
    rdfs:domain NCIT:NCIT_C25341,
        :CS26 ;
    rdfs:range :CS20 .

:CS27 a owl:Class ;
    rdfs:label "BRDCaseOutbreak"@en ;
    rdfs:comment "Bovine respiratory disease +ev cases in animal sample  at particualr time and region" ;
    rdfs:subClassOf :CS26 ;
    skos:altLabel "brdcase outbreak"@en .

:CS32 a owl:DatatypeProperty ;
    rdfs:label "hasFlockID"@en ;
    rdfs:comment "Unique identifier for a flock."@en ;
    rdfs:domain :CS28 ;
    rdfs:range xsd:string .

:CS33 a owl:DatatypeProperty ;
    rdfs:label "hasVetID"@en ;
    rdfs:comment "Identifier for the veterinarian responsible for the flock." ;
    rdfs:domain :CS28 ;
    rdfs:range xsd:string .

:CS34 a owl:DatatypeProperty ;
    rdfs:label "hasHatchDate"@en ;
    rdfs:comment "data type for hatching" ;
    rdfs:domain :CS28 ;
    rdfs:range xsd:date .

:CS35 a owl:DatatypeProperty ;
    rdfs:label "hasRemovalDate"@en ;
    rdfs:comment "Date when the flock was removed from the house or farm." ;
    rdfs:domain :CS28 ;
    rdfs:range xsd:date .

:CS36 a owl:DatatypeProperty ;
    rdfs:label "hasGrowthCurve"@en ;
    rdfs:comment "Records the growth pattern of the flock over time."@en ;
    rdfs:domain :CS28 ;
    rdfs:range xsd:string .

:CS37 a owl:DatatypeProperty ;
    rdfs:label "hasThinned"@en ;
    rdfs:comment "A data property that indicates whether the flock has undergone thinning (removal of some birds before full harvest)."@en ;
    rdfs:domain :CS28 ;
    rdfs:range xsd:string .

:CS38 a owl:ObjectProperty ;
    rdfs:label "hasAssociatedFlock"@en ;
    rdfs:comment "infer farm identification for particular poultry house" ;
    rdfs:domain :FarmIdentification ;
    rdfs:range :CS28 ;
    owl:propertyChainAxiom ( :CS63 :CS29 :CS30 ) .

:CS39 a <http://www.purl.org/decide#SampleType>,
        owl:NamedIndividual ;
