<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.purl.org/decide/LiveStockHealthOnto/LHO#"
     xml:base="http://www.purl.org/decide/LiveStockHealthOnto/LHO"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:LHO="http://www.purl.org/decide/LiveStockHealthOnto/LHO#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:NCIT="http://purl.obolibrary.org/obo/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#">
    <owl:Ontology rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO">
        <owl:versionIRI rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO/1.5"/>
        <NCIT:IAO_0000117>Saba Noor</NCIT:IAO_0000117>
        <dc:contributor>Saba Noor
Miel Hostens</dc:contributor>
        <hasExactSynonym xml:lang="en">LHO</hasExactSynonym>
        <rdfs:comment xml:lang="en">LHO integrates domain knowledge and data for livestock health. The ontology covers farms, samples, geolocation, breed, diagnostic tests, and pathogen identification, including bacteria like Histophilus somni, Mannheimia haemolytica, Pasteurella multocida, Bovine coronavirus, bacterial mycoplasma, and aerobic culture results in cattle. For pigs, it includes FarmType, age, weight, and pathogens like PRRS, SI and M_Hyponemoniea. In poultry, LHO incorporates FarmType, with specific pathogen names such as Infectious Bronchitis (IB), providing a concise overview of health aspects across livestock species.</rdfs:comment>
        <rdfs:comment xml:lang="en">https://www.purl.org/decide/LiveStockHealthOnto/LHO</rdfs:comment>
        <rdfs:seeAlso>An extension of DECIDE ontology

https://bioportal.bioontology.org/ontologies/DECIDE?p=summary</rdfs:seeAlso>
        <rdfs:seeAlso xml:lang="en">https://bioportal.bioontology.org/ontologies/LHO</rdfs:seeAlso>
        <owl:priorVersion xml:lang="en">V1.1</owl:priorVersion>
        <owl:priorVersion xml:lang="en">V1.3</owl:priorVersion>
        <owl:priorVersion xml:lang="en">V1.4</owl:priorVersion>
        <owl:versionInfo xml:lang="en">V1.5</owl:versionInfo>
        <skos:prefLabel xml:lang="en">Livestock Health Ontology</skos:prefLabel>
        <skos:altLabel xml:lang="ar">أنطولوجيا صحة الماشية</skos:altLabel>
        <skos:altLabel xml:lang="ar">صحة الماشية</skos:altLabel>
        <skos:altLabel xml:lang="ur">مویشیوں کی صحت کی آنٹولوجی</skos:altLabel>
        <skos:altLabel xml:lang="ur">مویشیوں کی صحت</skos:altLabel>
        <skos:altLabel xml:lang="nl">Ontologie voor veegezondheid</skos:altLabel>
        <skos:altLabel xml:lang="nl">Veegezondheidsontologie</skos:altLabel>
        <skos:altLabel xml:lang="nl">veegezondheid</skos:altLabel>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/IAO_0000112 -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0000112">
        <rdfs:comment>A string that provides a usage example of a class, property, or other ontology element to help users understand how it is applied.</rdfs:comment>
        <rdfs:label>example of usage</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000117 -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0000117">
        <NCIT:IAO_0000112>For example, in the context of cattle, breeds can be categorized as meat, dairy, or mixed breeds, each breed for specific agricultural or culinary purposes. Similarly, in the context of poultry, breeds can be categorized as meat breeds or egg-laying breeds. Pigs are also breed for meat production. The &apos;Breed&apos; class serves as a foundational concept for classifying and organizing various animal breeds within the ontology.</NCIT:IAO_0000112>
        <rdfs:comment>The person primarily responsible for the creation or curation of a given ontology term.</rdfs:comment>
        <rdfs:label>term editor</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000118 -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0000118">
        <rdfs:comment>A term or phrase that may be used as a synonym or alternate label for a given ontology entity, especially useful for searching and term matching.</rdfs:comment>
        <rdfs:label>alternative term</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000119 -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0000119">
        <rdfs:comment>A reference (such as a publication, URL, or ontology) that identifies where the definition of a term originated from.</rdfs:comment>
        <rdfs:label>definition source</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000412 -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0000412">
        <rdfs:comment>An annotation indicating the source ontology or resource from which a given term was imported.</rdfs:comment>
        <rdfs:label>imported from</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/dc/elements/1.1/contributor -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/contributor">
        <rdfs:comment>Person who contribute to the ontology</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasExactSynonym -->

    <owl:AnnotationProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasExactSynonym">
        <rdfs:comment>Exact synonyms are words that have completely identical or nearly identical meanings in given contexts</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#imported_from -->

    <owl:AnnotationProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#imported_from">
        <rdfs:comment>resource from where ontology is imported</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#version -->

    <owl:AnnotationProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#version">
        <rdfs:comment>version of ontology</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
    </owl:AnnotationProperty>
    




    <!-- http://www.w3.org/2002/07/owl#equivalentClass -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#equivalentClass"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#prefLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS23 -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS23">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCIT_C25341"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide#Pathogen"/>
        <rdfs:comment>Links a region to pathogen prevalence.</rdfs:comment>
        <rdfs:label xml:lang="en">hasPrevalence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS24 -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS24">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCIT_C25341"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS22"/>
        <rdfs:comment xml:lang="en">Links a region to BRD case records.</rdfs:comment>
        <rdfs:label xml:lang="en">hasBRDCase</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS25 -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS25">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCIT_C25341"/>
        <rdfs:domain rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS26"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS20"/>
        <rdfs:comment>Links a region to a specific time period.</rdfs:comment>
        <rdfs:label xml:lang="en">hasTimePeriod</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS29 -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS29">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Farm"/>
        <rdfs:domain rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS62"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS00"/>
        <rdfs:comment xml:lang="en">Links a farm to one or more houses within it.</rdfs:comment>
        <rdfs:label xml:lang="en">hasHouse</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS30 -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS30">
        <rdfs:domain rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS00"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS28"/>
        <rdfs:comment>Links a house to one or more flocks within it.</rdfs:comment>
        <rdfs:label xml:lang="en">hasFlock</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS31 -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS31">
        <rdfs:domain rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS28"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:comment xml:lang="en">Links a flock to its associated poultry sample.</rdfs:comment>
        <rdfs:label xml:lang="en">hasSample</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS38 -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS38">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS63"/>
            <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS29"/>
            <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS30"/>
        </owl:propertyChainAxiom>
        <rdfs:domain rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#FarmIdentification"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS28"/>
        <rdfs:comment>infer farm identification for particular poultry house</rdfs:comment>
        <rdfs:label xml:lang="en">hasAssociatedFlock</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS43 -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS43">
        <rdfs:domain rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockProductionStages"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide#ProductionCycleTime"/>
        <rdfs:comment>Links a production stage to a concept representing the time duration of that stage.</rdfs:comment>
        <rdfs:label xml:lang="en">hasCycleTime</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS47 -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS47">
        <rdfs:domain rdf:resource="http://opendata.inra.fr/AHOL/AHOL_0005001"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide#Pathogen"/>
        <rdfs:comment>Disease cause link to pathogen</rdfs:comment>
        <rdfs:label xml:lang="en">causedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS56 -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS56">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#ActualBiomass"/>
        <rdfs:comment>Object property linked Salmon sample with Actual Biomass property</rdfs:comment>
        <rdfs:label xml:lang="en">hasActualBiomass</rdfs:label>
        <rdfs:comment xml:lang="en">Deprecated in V1.5: use the data property actualBiomass (CS91) with a numeric value.</rdfs:comment>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <dcterms:isReplacedBy rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS91"/>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS57 -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS57">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#WaterType"/>
        <rdfs:comment>object property that link Salmon sample with water type for eaxmple Freshwater, Seawater, BrackishWater</rdfs:comment>
        <rdfs:label xml:lang="en">hasWaterType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS58 -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS58">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Mortality"/>
        <rdfs:comment>Object property that links a Salmon sample with the mortality recorded for that sample.</rdfs:comment>
        <rdfs:label xml:lang="en">hasMortality</rdfs:label>
        <rdfs:comment xml:lang="en">Deprecated in V1.5: use the data property mortality (CS59) with a numeric value.</rdfs:comment>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <dcterms:isReplacedBy rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS59"/>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS60 -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS60">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LocalAuthority"/>
        <rdfs:comment>Object property that link physical region or location</rdfs:comment>
        <rdfs:label xml:lang="en">hasLocalAuthority</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS63 -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS63">
        <rdfs:domain rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#FarmIdentification"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS62"/>
        <rdfs:comment>Object property that links  a unique identifier specific to poultry farms, used for traceability and health monitoring purposes.</rdfs:comment>
        <rdfs:label xml:lang="en">hasPoultryFarmIdentification</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#affectsSpecies -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#affectsSpecies">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Species"/>
        <rdfs:comment xml:lang="en">Links a pathogen, breed, sample type, or country to the species it applies to. Used to filter species-specific categories in a multi-species ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">affectsSpecies</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#causesDisease -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#causesDisease">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Pathogen"/>
        <rdfs:range rdf:resource="http://opendata.inra.fr/AHOL/AHOL_0005001"/>
        <rdfs:comment xml:lang="en">Links a pathogen to the type of disease it causes. Used to classify pathogens into Viral or Bacterial groups for graph construction.</rdfs:comment>
        <rdfs:label xml:lang="en">causesDisease</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasAge -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasAge">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Age"/>
        <rdfs:comment>link a sample to age Unit</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasBreed -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasBreed">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Breed"/>
        <rdfs:comment>Link a sample to specific  animal breed.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasCountry -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasCountry">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/NCIT_C25464"/>
        <rdfs:comment>Sample belong to which country</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasDate -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasDate">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Date"/>
        <rdfs:comment>animal sample date</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasDiagnosticTest -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasDiagnosticTest">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#DiagnosticTest"/>
        <rdfs:comment>Links a sample to a test performed.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasEventType -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasEventType">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide#EventType"/>
        <rdfs:comment>link sample to event at which it perform</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasFarmIdentification -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasFarmIdentification">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.purl.org/decide#Farm"/>
                    <rdf:Description rdf:about="http://www.purl.org/decide#Sample"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#FarmIdentification"/>
        <rdfs:comment>Links a sample or a farm to unique farm ID</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasFarmType -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasFarmType">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#FarmType"/>
        <rdfs:comment>link sample to the farm type</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasGeographicNeighbor -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasGeographicNeighbor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCIT_C25464"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/NCIT_C25464"/>
        <rdfs:comment xml:lang="en">Symmetric property indicating two countries share a geographic land border. Used to create geographic adjacency edges in the knowledge graph.</rdfs:comment>
        <rdfs:label xml:lang="en">hasGeographicNeighbor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasLabReference -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasLabReference">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LabReference"/>
        <rdfs:comment>Link Lab reference,for identification and tracking within a laboratory or data system if Farm Identification is not available</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasPathogen -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasPathogen">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide#Pathogen"/>
        <rdfs:comment>link sample to specific pathogen</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasProvince -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasProvince">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Province"/>
        <rdfs:comment>link sample to region</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasSampleNumber -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasSampleNumber">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#SampleNumber"/>
        <rdfs:comment>link sample to its unique sample Number if available</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasSampleResult -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasSampleResult">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide#SampleResult"/>
        <rdfs:comment>Link Sample to result positive 1 or negative 0</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasResult -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasResult">
        <rdfs:subPropertyOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasSampleResult"/>
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:label xml:lang="en">hasResult</rdfs:label>
        <rdfs:comment xml:lang="en">Links a sample to its test result, positive (1) or negative (0). This is the property used in the RDF data of the Cattle, Pig and Poultry Barometers. It is a subproperty of hasSampleResult.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasProductionStages -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasProductionStages">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockProductionStages"/>
        <rdfs:label xml:lang="en">hasProductionStages</rdfs:label>
        <rdfs:comment xml:lang="en">Links a sample to the production stage of the animal or group it was taken from, for example Nursery, Finishing or Broiler.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasSampleType -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasSampleType">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide#SampleType"/>
        <rdfs:comment>Associates a Sample with a SampleType indicating the kind of material collected, such as blood, tissue, feces, or water.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasTimeUnit -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasTimeUnit">
        <rdfs:domain rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Age"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#TimeUnit"/>
        <rdfs:comment>Linking Animal age with TimeUnit</rdfs:comment>
        <rdfs:comment>Time unit like Months, days, minutes etc...</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasWeight -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasWeight">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Weight"/>
        <rdfs:comment>link animal sample weight</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasWeightUnit -->

    <owl:ObjectProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasWeightUnit">
        <rdfs:domain rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Weight"/>
        <rdfs:range rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#WeightUnit"/>
        <rdfs:comment xml:lang="en">A unit of measurement used to express the weight or mass of an animal, feed, or product. 
Common examples include kilogram (kg), gram (g), and tonne (t).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS10 -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS10">
        <rdfs:domain rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Province"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>data type vlaue Represents the prevalence rate of a pathogen in a province.</rdfs:comment>
        <rdfs:label xml:lang="en">hasProvincePathogenPrevalence</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS11 -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS11">
        <rdfs:domain rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Province"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Count of BRD cases in a province.</rdfs:comment>
        <rdfs:label xml:lang="en">hasProvinceNoOfBRD</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS12 -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS12">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCIT_C25464"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">percentage % of cases in a country.</rdfs:comment>
        <rdfs:label xml:lang="en">hasCountryPathogenPrevalence</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS13 -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS13">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCIT_C25464"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Count of positive  BRD cases in a country.</rdfs:comment>
        <rdfs:label xml:lang="en">hasCountryNoOfBRD</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS14 -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS14">
        <rdfs:domain rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS20"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>% of cases in a quarter.</rdfs:comment>
        <rdfs:label xml:lang="en">hasQuarterPathogenPrevalence</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS15 -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS15">
        <rdfs:domain rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS20"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Count of BRD cases in Quarter</rdfs:comment>
        <rdfs:label xml:lang="en">hasQuarterNoOfBRD</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS16 -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS16">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.purl.org/decide#Sample"/>
                    <rdf:Description rdf:about="http://www.purl.org/decide#SampleResult"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A data property that tells whether a sample tested positive (1) or negative (0).</rdfs:comment>
        <rdfs:label xml:lang="en">result</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS17 -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS17">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Date when the sample was collected.</rdfs:comment>
        <rdfs:label xml:lang="en">date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS18 -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS18">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Unique ID for each sample.</rdfs:comment>
        <rdfs:label xml:lang="en">hasSampleNumber</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS32 -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS32">
        <rdfs:domain rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS28"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Unique identifier for a flock.</rdfs:comment>
        <rdfs:label xml:lang="en">hasFlockID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS33 -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS33">
        <rdfs:domain rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS28"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Identifier for the veterinarian responsible for the flock.</rdfs:comment>
        <rdfs:label xml:lang="en">hasVetID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS34 -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS34">
        <rdfs:domain rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS28"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>data type for hatching</rdfs:comment>
        <rdfs:label xml:lang="en">hasHatchDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS35 -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS35">
        <rdfs:domain rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS28"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Date when the flock was removed from the house or farm.</rdfs:comment>
        <rdfs:label xml:lang="en">hasRemovalDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS36 -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS36">
        <rdfs:domain rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS28"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Records the growth pattern of the flock over time.</rdfs:comment>
        <rdfs:label xml:lang="en">hasGrowthCurve</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS37 -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS37">
        <rdfs:domain rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS28"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A data property that indicates whether the flock has undergone thinning (removal of some birds before full harvest).</rdfs:comment>
        <rdfs:label xml:lang="en">hasThinned</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasWeaningDate -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasWeaningDate">
        <rdfs:domain rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CattleSample"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Date on which a calf was weaned.</rdfs:comment>
        <rdfs:label xml:lang="en">hasWeaningDate</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasFinishingDate -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasFinishingDate">
        <rdfs:domain rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CattleSample"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Date on which cattle entered the finishing stage.</rdfs:comment>
        <rdfs:label xml:lang="en">hasFinishingDate</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS45 -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS45">
        <rdfs:domain rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS00"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Define data property of house</rdfs:comment>
        <rdfs:label xml:lang="en">houseNumber</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS59 -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS59">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Data type property that gives the mortality recorded for a sample, as the total weight of dead animals in kg (e.g. a salmon farm record).</rdfs:comment>
        <rdfs:label xml:lang="en">mortality</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS91 -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS91">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Data type property that gives the numeric actual biomass (total live weight in kg) recorded for a sample (e.g. a salmon farm record).</rdfs:comment>
        <rdfs:label xml:lang="en">actualBiomass</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#breed -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#breed">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>data type that Represents breed like beef, mixed, Veal, suckler</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#country -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#country">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCIT_C25464"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Data type Country naming type string</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#pathogen -->

    <owl:DatatypeProperty rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#pathogen">
        <rdfs:domain rdf:resource="http://www.purl.org/decide#Pathogen"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A data property that discribes  a name of the pathogen in animal sample</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://aims.fao.org/aos/agrovoc/c_16398 -->

    <owl:Class rdf:about="http://aims.fao.org/aos/agrovoc/c_16398">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PathogenicVirus"/>
        <NCIT:IAO_0000412>https://agrovoc.fao.org/browse/agrovoc/en/</NCIT:IAO_0000412>
        <hasExactSynonym xml:lang="en">BRSV</hasExactSynonym>
        <rdfs:comment xml:lang="en">Bovine Respiratory Syncytial Virus (BRSV) is a major cause of respiratory disease in cattle, characterized by coughing, nasal discharge, and increased respiratory rate.</rdfs:comment>
        <rdfs:isDefinedBy xml:lang="en">https://agrovoc.fao.org/browse/agrovoc/en/page/c_16398</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">BovineRespiratorySyncytialVirus</rdfs:label>
    </owl:Class>
    


    <!-- http://aims.fao.org/aos/agrovoc/c_26545 -->

    <owl:Class rdf:about="http://aims.fao.org/aos/agrovoc/c_26545">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Parasite"/>
        <rdfs:comment>Lepeophtheirus salmonis (Sea Lice): A parasitic copepod that infests salmon, causing significant issues in aquaculture</rdfs:comment>
        <rdfs:label>Lepeophtheirus salmonis</rdfs:label>
        <rdfs:seeAlso>https://www.gbif.org/species/165408210</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://aims.fao.org/aos/agrovoc/c_27241 -->

    <owl:Class rdf:about="http://aims.fao.org/aos/agrovoc/c_27241">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PathogenicBacterium"/>
        <NCIT:IAO_0000412>https://agrovoc.fao.org/browse/agrovoc/en/</NCIT:IAO_0000412>
        <hasExactSynonym>MB</hasExactSynonym>
        <rdfs:comment xml:lang="en">Mycoplasma bovis is a bacterial pathogen that primarily affects cattle, causing respiratory disease, arthritis, mastitis, and other systemic infections.</rdfs:comment>
        <rdfs:isDefinedBy>https://agrovoc.fao.org/browse/agrovoc/en/page/c_27241</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">MycoplasmaBovis</rdfs:label>
    </owl:Class>
    


    <!-- http://aims.fao.org/aos/agrovoc/c_27245 -->

    <owl:Class rdf:about="http://aims.fao.org/aos/agrovoc/c_27245">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PathogenicBacterium"/>
        <hasExactSynonym>M.Hyopneumoniae</hasExactSynonym>
        <hasExactSynonym xml:lang="en">M_Hyopneumoniae</hasExactSynonym>
        <rdfs:comment xml:lang="en">Mycoplasma hyopneumoniae is a bacterium causing swine enzootic pneumonia, a respiratory disease in pigs, characterized by coughing and impaired respiratory function.</rdfs:comment>
        <rdfs:label xml:lang="en">MycoplasmaHyopneumoniae</rdfs:label>
    </owl:Class>
    


    <!-- http://aims.fao.org/aos/agrovoc/c_2c550294 -->

    <owl:Class rdf:about="http://aims.fao.org/aos/agrovoc/c_2c550294">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PathogenicVirus"/>
        <NCIT:IAO_0000412>ISAV</NCIT:IAO_0000412>
        <NCIT:IAO_0000412>https://agrovoc.fao.org/browse/agrovoc/en/</NCIT:IAO_0000412>
        <hasExactSynonym>Infectious salmon anaemia</hasExactSynonym>
        <rdfs:comment>Causes Infectious Salmon Anemia (ISA), a serious viral disease in Atlantic salmon</rdfs:comment>
        <rdfs:label>InfectiousSalmonAnemiaVirus</rdfs:label>
    </owl:Class>
    


    <!-- http://aims.fao.org/aos/agrovoc/c_33359 -->

    <owl:Class rdf:about="http://aims.fao.org/aos/agrovoc/c_33359">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PathogenicBacterium"/>
        <NCIT:IAO_0000412>https://agrovoc.fao.org/browse/agrovoc/en/</NCIT:IAO_0000412>
        <hasExactSynonym xml:lang="en">HS</hasExactSynonym>
        <rdfs:comment xml:lang="en">Haemophilus somnus classified as Histophilus somni, is a Gram-negative bacterium that can cause respiratory and systemic infections in cattle and other domestic and farm animals</rdfs:comment>
        <rdfs:isDefinedBy xml:lang="en">https://agrovoc.fao.org/browse/agrovoc/en/page/c_33359</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">HistophilusSomnus</rdfs:label>
    </owl:Class>
    


    <!-- http://aims.fao.org/aos/agrovoc/c_34495 -->

    <owl:Class rdf:about="http://aims.fao.org/aos/agrovoc/c_34495">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PathogenicBacterium"/>
        <NCIT:IAO_0000412>https://agrovoc.fao.org/browse/agrovoc/en/</NCIT:IAO_0000412>
        <hasExactSynonym>PH</hasExactSynonym>
        <rdfs:comment xml:lang="en">Pasteurella haemolytica is a Gram-negative bacterium associated with respiratory infections, particularly in cattle, causing bovine respiratory disease complex (BRDC) or shipping fever.</rdfs:comment>
        <rdfs:isDefinedBy>https://agrovoc.fao.org/browse/agrovoc/en/page/c_34495</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">PasteurellaHaemolytica</rdfs:label>
        <rdfs:comment xml:lang="en">Former name of Mannheimia haemolytica (reclassified in 1999); kept because existing data may use either name.</rdfs:comment>
    </owl:Class>
    


    <!-- http://aims.fao.org/aos/agrovoc/c_35380 -->

    <owl:Class rdf:about="http://aims.fao.org/aos/agrovoc/c_35380">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PathogenicVirus"/>
        <hasExactSynonym xml:lang="en">PRRS</hasExactSynonym>
        <rdfs:comment xml:lang="en">Porcine Reproductive and Respiratory Syndrome (PRRS) is a viral disease in pigs, causing reproductive failure in sows and respiratory symptoms in pigs of all ages.</rdfs:comment>
        <rdfs:isDefinedBy>https://agrovoc.fao.org/browse/agrovoc/en/page/c_35380</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">PorcineReproductiveAndRespiratorySyndromeVirus</rdfs:label>
    </owl:Class>
    


    <!-- http://aims.fao.org/aos/agrovoc/c_6145 -->

    <owl:Class rdf:about="http://aims.fao.org/aos/agrovoc/c_6145">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Species"/>
        <NCIT:IAO_0000412>https://agrovoc.fao.org/browse/agrovoc/en/page/c_6145</NCIT:IAO_0000412>
        <rdfs:comment>All domesticated birds used for the production of meat or eggs for consumption, for the production of other commercial products, for restocking, supplies of game, or for breeding these categories of birds.</rdfs:comment>
        <rdfs:label xml:lang="en">Poultry</rdfs:label>
        <skos:altLabel xml:lang="en">poultry</skos:altLabel>
    </owl:Class>
    


    <!-- http://aims.fao.org/aos/agrovoc/c_6214dcad -->

    <owl:Class rdf:about="http://aims.fao.org/aos/agrovoc/c_6214dcad">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PathogenicVirus"/>
        <hasExactSynonym xml:lang="en">SI</hasExactSynonym>
        <rdfs:comment xml:lang="en">Swine Influenza is a respiratory viral infection in pigs, characterized by coughing, sneezing, and fever, with potential transmission to humans.</rdfs:comment>
        <rdfs:isDefinedBy>https://agrovoc.fao.org/browse/agrovoc/en/page/c_6214dcad</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">SwineInfluenzaVirus</rdfs:label>
    </owl:Class>
    


    <!-- http://aims.fao.org/aos/agrovoc/c_7555 -->

    <owl:Class rdf:about="http://aims.fao.org/aos/agrovoc/c_7555">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Species"/>
        <NCIT:IAO_0000412>https://aims.fao.org/aos/agrovoc/c_7555.html</NCIT:IAO_0000412>
        <rdfs:comment>The pig (Sus domesticus), often called swine, hog, or domestic pig</rdfs:comment>
        <rdfs:label xml:lang="en">Pig</rdfs:label>
        <skos:altLabel xml:lang="en">pig</skos:altLabel>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9823"/>
    </owl:Class>
    


    <!-- http://opendata.inra.fr/AHOL/AHOL_0005001 -->

    <owl:Class rdf:about="http://opendata.inra.fr/AHOL/AHOL_0005001">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <NCIT:IAO_0000412>http://opendata.inra.fr/AHOL/</NCIT:IAO_0000412>
        <rdfs:isDefinedBy>Damage on the health. The modifications of an organism defending itself against an infection or another damager factor. Perturbation of the animal&apos;s normal functions.</rdfs:isDefinedBy>
        <rdfs:isDefinedBy>https://bioportal.bioontology.org/ontologies/AHOL?p=summary</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Disease</rdfs:label>
    </owl:Class>
    


    <!-- http://opendata.inra.fr/AHOL/AHOL_0005011 -->

    <owl:Class rdf:about="http://opendata.inra.fr/AHOL/AHOL_0005011">
        <rdfs:subClassOf rdf:resource="http://opendata.inra.fr/AHOL/AHOL_0005001"/>
        <NCIT:IAO_0000412>https://bioportal.bioontology.org/ontologies/AHOL?p=summary</NCIT:IAO_0000412>
        <rdfs:comment>Infectious disease class includes diseases caused by pathogens such as viruses, bacteria, fungi, or parasites that can spread between animals, humans, or both</rdfs:comment>
        <rdfs:label>Infectious Disease</rdfs:label>
    </owl:Class>
    


    <!-- http://opendata.inra.fr/AHOL/AHOL_0005015 -->

    <owl:Class rdf:about="http://opendata.inra.fr/AHOL/AHOL_0005015">
        <rdfs:subClassOf rdf:resource="http://opendata.inra.fr/AHOL/AHOL_0005011"/>
    </owl:Class>
    


    <!-- http://opendata.inra.fr/AHOL/AHOL_0005012 -->

    <owl:Class rdf:about="http://opendata.inra.fr/AHOL/AHOL_0005012">
        <rdfs:subClassOf rdf:resource="http://opendata.inra.fr/AHOL/AHOL_0005011"/>
    </owl:Class>
    


    <!-- http://opendata.inra.fr/AnimalDiseasesOnto/AG34 -->

    <owl:Class rdf:about="http://opendata.inra.fr/AnimalDiseasesOnto/AG34">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PathogenicVirus"/>
        <NCIT:IAO_0000412>http://opendata.inra.fr/AnimalDiseasesOnto/</NCIT:IAO_0000412>
        <hasExactSynonym xml:lang="en">BCV</hasExactSynonym>
        <rdfs:comment xml:lang="en">Bovine coronavirus primarily causes enteric (intestinal) infections in calves, leading to diarrhea.</rdfs:comment>
        <rdfs:isDefinedBy>http://opendata.inra.fr/AnimalDiseasesOnto/AG34</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">BovineCoronaVirus</rdfs:label>
    </owl:Class>
    


    <!-- http://opendata.inra.fr/AnimalDiseasesOnto/AG509 -->

    <owl:Class rdf:about="http://opendata.inra.fr/AnimalDiseasesOnto/AG509">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PathogenicVirus"/>
        <NCIT:IAO_0000412>http://opendata.inra.fr/AnimalDiseasesOnto</NCIT:IAO_0000412>
        <hasExactSynonym xml:lang="en">IB</hasExactSynonym>
        <rdfs:comment xml:lang="en">Infectious bronchitis is a highly contagious viral respiratory disease in chickens, characterized by respiratory distress and egg production drops.</rdfs:comment>
        <rdfs:isDefinedBy>http://opendata.inra.fr/AnimalDiseasesOnto/AG509</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">InfectiousBronchitisVirus</rdfs:label>
    </owl:Class>
    


    <!-- http://opendata.inra.fr/AnimalDiseasesOnto/AG744 -->

    <owl:Class rdf:about="http://opendata.inra.fr/AnimalDiseasesOnto/AG744">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PathogenicBacterium"/>
        <NCIT:IAO_0000412>http://opendata.inra.fr/AnimalDiseasesOnto</NCIT:IAO_0000412>
        <hasExactSynonym xml:lang="en">MH</hasExactSynonym>
        <rdfs:comment xml:lang="en">Mannheimia haemolytica is a bacterium associated with bovine respiratory disease in cattle, causing pneumonia and respiratory distress.</rdfs:comment>
        <rdfs:isDefinedBy xml:lang="en">http://opendata.inra.fr/AnimalDiseasesOnto/AG744</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">MannheimiaHaemolytica</rdfs:label>
    </owl:Class>
    


    <!-- http://opendata.inra.fr/AnimalDiseasesOnto/AG78 -->

    <owl:Class rdf:about="http://opendata.inra.fr/AnimalDiseasesOnto/AG78">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PathogenicBacterium"/>
        <NCIT:IAO_0000412>https://opendata.inra.fr/AnimalDiseasesOnto/page/Ando</NCIT:IAO_0000412>
        <rdfs:comment xml:lang="en">Pasteurella multocida is a bacterial pathogen in cattle associated with respiratory infections, causing pneumonia and other respiratory symptoms.</rdfs:comment>
        <rdfs:label xml:lang="en">PasteurellaMultocida</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000027">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <NCIT:IAO_0000412>obo:IAO_0000119  &quot;http://purl.obolibrary.org/obo/iao.owl&quot; .</NCIT:IAO_0000412>
        <rdfs:comment>An information content entity that specifies how a realizable entity is concretized, and that is not concretized in the specification itself.</rdfs:comment>
        <rdfs:label>measurement datum</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C25341 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C25341">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <rdfs:comment>Location refers to a specific place or area where an event, object, or entity exists or occurs.</rdfs:comment>
        <rdfs:isDefinedBy>https://ontobee.org/ontology/NCIT?iri=http://purl.obolibrary.org/obo/NCIT_C25341</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Location</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C25464 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C25464">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C25341"/>
        <hasExactSynonym xml:lang="en">COUNTRY; Country</hasExactSynonym>
        <imported_from xml:lang="en">http://purl.obolibrary.org/obo/ncit.owl</imported_from>
        <rdfs:label xml:lang="en">Country</rdfs:label>
        <rdfs:seeAlso>https://www.w3.org/2000/01/rdf-schema#</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.ncbi.nlm.nih.gov/taxonomy/9913 -->

    <owl:Class rdf:about="http://www.ncbi.nlm.nih.gov/taxonomy/9913">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Species"/>
        <rdfs:comment>(domestic cattle)</rdfs:comment>
        <rdfs:label xml:lang="en">Cattle</rdfs:label>
    </owl:Class>
    


    <!-- http://www.purl.org/decide#Event -->

    <owl:Class rdf:about="http://www.purl.org/decide#Event">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <NCIT:IAO_0000119>http://www.purl.org/decide#Event</NCIT:IAO_0000119>
        <imported_from>https://bioportal.bioontology.org/ontologies/DECIDE?p=classes</imported_from>
        <rdfs:comment>A class representing any occurrence or activity related to aquaculture or livestock management, such as disease outbreaks, treatments, movements, or inspections.</rdfs:comment>
        <rdfs:label>Event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.purl.org/decide#EventType -->

    <owl:Class rdf:about="http://www.purl.org/decide#EventType">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <NCIT:IAO_0000412>https://bioportal.bioontology.org/ontologies/DECIDE?p=classes</NCIT:IAO_0000412>
        <rdfs:comment xml:lang="en">It refer to different types of events related to livestock or farming. For example, &quot;slaughter&quot; could be one event type, and &quot;birth,&quot; &quot;vaccination,&quot; or &quot;disease outbreak&quot; could be other event types.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide#Farm -->

    <owl:Class rdf:about="http://www.purl.org/decide#Farm">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <NCIT:IAO_0000412>https://bioportal.bioontology.org/ontologies/DECIDE?p=summary</NCIT:IAO_0000412>
        <rdfs:comment xml:lang="en">A farm is an agricultural or aquacultural establishment where crops are cultivated, terrestrial livestock and/or aquatic species (such as fish or shellfish) are raised for food production or other commercial, research, or conservation purposes.</rdfs:comment>
        <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_2809"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide#Measurement -->

    <owl:Class rdf:about="http://www.purl.org/decide#Measurement">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <NCIT:IAO_0000412>https://bioportal.bioontology.org/ontologies/DECIDE?p=summary</NCIT:IAO_0000412>
        <rdfs:comment>A record of an observed or measured value related to a specific characteristic (such as weight, age, or temperature) of an animal, population, environment, or system, applicable to both terrestrial livestock and aquaculture species</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide#MeasurementType -->

    <owl:Class rdf:about="http://www.purl.org/decide#MeasurementType">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <NCIT:IAO_0000412>https://bioportal.bioontology.org/ontologies/DECIDE?p=summary</NCIT:IAO_0000412>
        <rdfs:comment>A classification of measurement, such as weight or age</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide#Pathogen -->

    <owl:Class rdf:about="http://www.purl.org/decide#Pathogen">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <NCIT:IAO_0000412>https://bioportal.bioontology.org/ontologies/DECIDE?p=summary</NCIT:IAO_0000412>
        <rdfs:comment xml:lang="en">A pathogen is an organism or infectious agent, such as a bacterium, virus or parasite, that causes disease in its host, be it plants, animals, or humans.</rdfs:comment>
        <rdfs:label xml:lang="en">Pathogen</rdfs:label>
        <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_5630"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide#ProductionCycleTime -->

    <owl:Class rdf:about="http://www.purl.org/decide#ProductionCycleTime">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <NCIT:IAO_0000412>https://bioportal.bioontology.org/ontologies/DECIDE?p=summary</NCIT:IAO_0000412>
        <rdfs:comment xml:lang="en">ProductionCycleTime refers to the duration of a specific production stage or the entire production process in aquaculture or livestock farming. 

It is used to describe the time span from the beginning to the end of a defined stage (e.g., nursery, finishing) or the complete cycle.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide#Sample -->

    <owl:Class rdf:about="http://www.purl.org/decide#Sample">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <rdfs:comment>A base class for Animal Samples</rdfs:comment>
        <rdfs:comment xml:lang="en">A sample, such as a CattleSample, PigSample, or PoultrySample, refers to a specimen collected from respective animals for diagnostic or research purposes, often involving testing for diseases or analyzing biological parameters.</rdfs:comment>
        <rdfs:label xml:lang="en">Sample</rdfs:label>
        <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_875b7e95"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide#SampleResult -->

    <owl:Class rdf:about="http://www.purl.org/decide#SampleResult">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <NCIT:IAO_0000412>https://bioportal.bioontology.org/ontologies/DECIDE?p=summary</NCIT:IAO_0000412>
        <rdfs:comment xml:lang="en">SampleResult represents the outcome or findings derived from analyzing a specimen, providing valuable information about the health or characteristics of the sampled subject, whether it be cattle, pig, poultry, or another source.</rdfs:comment>
        <rdfs:label>SampleResult</rdfs:label>
    </owl:Class>
    


    <!-- http://www.purl.org/decide#SampleType -->

    <owl:Class rdf:about="http://www.purl.org/decide#SampleType">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <NCIT:IAO_0000412>https://bioportal.bioontology.org/ontologies/DECIDE?p=summary</NCIT:IAO_0000412>
        <rdfs:comment xml:lang="en">SampleType</rdfs:comment>
        <rdfs:comment xml:lang="en">SampleType describes the kind of material or source from which a sample is collected for analysis. 
Examples include blood, tissue, feces, milk, water, feed, or environmental swabs. 
It is used to classify samples according to their origin and is essential for interpreting diagnostic and surveillance data.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide#SpeciesGroup -->

    <owl:Class rdf:about="http://www.purl.org/decide#SpeciesGroup">
        <owl:equivalentClass rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Species"/>
        <NCIT:IAO_0000412>https://bioportal.bioontology.org/ontologies/DECIDE?p=summary</NCIT:IAO_0000412>
        <rdfs:comment>SpeciesGroup represents a group of animals belonging to the same species or production category 
    (e.g., Atlantic salmon, broiler chickens, weaned piglets, dairy cattle). 
    It is used to describe the target population involved in events such as sampling, treatment, or observation.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide#Unit -->

    <owl:Class rdf:about="http://www.purl.org/decide#Unit">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <NCIT:IAO_0000119>https://bioportal.bioontology.org/ontologies/DECIDE?p=summary</NCIT:IAO_0000119>
        <imported_from xml:lang="en">http://www.purl.org/decide#Unit</imported_from>
        <rdfs:comment xml:lang="en">The class representing a unit of measurement or denomination. Instances of this class may include various units such as length units, weight units, time units, etc. It serves as a general category for expressing quantitative values in a standardized manner across different domains.</rdfs:comment>
        <rdfs:label>Unit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.purl.org/decide#Veterinarian -->

    <owl:Class rdf:about="http://www.purl.org/decide#Veterinarian">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <NCIT:IAO_0000412>https://bioportal.bioontology.org/ontologies/DECIDE?p=summary</NCIT:IAO_0000412>
        <rdfs:comment>A Veterinarian is a qualified and licensed professional responsible for the health and welfare of animals. 
    Veterinarians perform clinical examinations, diagnose diseases, prescribe treatments, and provide guidance on prevention, vaccination, and biosecurity in livestock and aquaculture settings.</rdfs:comment>
        <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_8203"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#ActualBiomass -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#ActualBiomass">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <rdfs:comment>Represents the total measured live body weight of the sampled population in kilograms at a specific timepoint.</rdfs:comment>
        <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_926"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Age -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Age">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide#MeasurementType"/>
        <rdfs:comment>A measurement Type</rdfs:comment>
        <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_186"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Autopsy -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Autopsy">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide#SampleType"/>
        <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_6134"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#BAL -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#BAL">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide#SampleType"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Beef -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Beef">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Breed"/>
        <owl:disjointWith rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Egglaying"/>
        <rdfs:comment>Breeds can be categorized as meat, beef</rdfs:comment>
        <rdfs:label xml:lang="en">Beef</rdfs:label>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#BirthEvent -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#BirthEvent">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide#EventType"/>
        <NCIT:IAO_0000119>Birth event refers to the occurrence of a living being coming into the world.</NCIT:IAO_0000119>
        <rdfs:comment xml:lang="en">Birth event refers to the occurrence of a living being coming into the world.</rdfs:comment>
        <rdfs:label xml:lang="en">BirthEvent</rdfs:label>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Blood -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Blood">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide#SampleType"/>
        <rdfs:comment xml:lang="en">Blood is a SampleType. A blood sample is a specimen collected from an organism, typically through venipuncture, and is used for diagnostic or research purposes, providing insights into the health and physiological parameters of the individual.</rdfs:comment>
        <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_959"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Breed -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Breed">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <rdfs:comment xml:lang="en">Breeds are used to categorize and classify animals based on specific characteristics, traits, and purposes.</rdfs:comment>
        <rdfs:label xml:lang="en">Breed</rdfs:label>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Breeder -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Breeder">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PoultryProductionStages"/>
        <rdfs:comment>Birds (hens and roosters) are raised for reproduction to produce fertilized eggs for hatching.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Breeding -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Breeding">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PigProductionStages"/>
        <rdfs:comment>Pid production Breeding stage in pigs involves reproductive activities where a sow (mature female), boar (male pig), and gilt (young female yet to farrow but ready to breed) participate in the mating process.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#BreedingFarm -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#BreedingFarm">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#FarmType"/>
        <rdfs:comment xml:lang="en">A BreedingFarm may focus on breeding and raising animals for specific traits.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Broiler -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Broiler">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PoultryProductionStages"/>
        <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_9435"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS00 -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS00">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <rdfs:comment xml:lang="en">Represents a housing unit within a farm where a poultry flock is kept.</rdfs:comment>
        <rdfs:label xml:lang="en">House</rdfs:label>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS20 -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS20">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide#Unit"/>
        <rdfs:comment>A time-based unit representing one-fourth of a year, typically spanning three months.</rdfs:comment>
        <rdfs:label xml:lang="en">Quarter</rdfs:label>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS22 -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS22">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <rdfs:comment xml:lang="en">Represents the number of BRD cases in a region/time.</rdfs:comment>
        <rdfs:label xml:lang="en">BRDCasesObservation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS26 -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS26">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide#EventType"/>
        <rdfs:comment xml:lang="en">Represents disease outbreaks linked to regions, time, and pathogens.</rdfs:comment>
        <rdfs:label xml:lang="en">DiseaseOutBreak</rdfs:label>
        <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_164ea2ee"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS27 -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS27">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS26"/>
        <rdfs:comment>Bovine respiratory disease +ev cases in animal sample  at particualr time and region</rdfs:comment>
        <rdfs:label xml:lang="en">BRDCaseOutbreak</rdfs:label>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS28 -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS28">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <rdfs:comment xml:lang="en">Represents a group of poultry birds in a specific house at a farm, forming a distinct management unit.</rdfs:comment>
        <rdfs:label xml:lang="en">Flock</rdfs:label>
        <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_10913"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS62 -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS62">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#FarmIdentification"/>
        <rdfs:comment>A unique identifier specific to poultry farms, used for traceability and health monitoring purposes.</rdfs:comment>
        <rdfs:label xml:lang="en">PoultryFarmIdentification</rdfs:label>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS65 -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS65">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <rdfs:comment>Prevalence refers to the proportion of a population that has a specific characteristic or condition at a given time. It is often used in public health to indicate how widespread a disease is within a population.</rdfs:comment>
        <rdfs:label xml:lang="en">Prevelance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CattleProductionStages -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CattleProductionStages">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockProductionStages"/>
        <rdfs:comment>Livestock production stages are the sequential phases in the life and management of farm cattles</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CattleSample -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CattleSample">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:comment xml:lang="en">CattleSamples are the  &quot;n&quot; number of observations  for Cattle</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Dairy -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Dairy">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Breed"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Date -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Date">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <rdfs:comment>Date</rdfs:comment>
        <rdfs:label>Date</rdfs:label>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Day -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Day">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#TimeUnit"/>
        <rdfs:comment>A unit of time equal to 24 hours, used for short-term measurements or daily records</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#DiagnosticTest -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#DiagnosticTest">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <rdfs:comment xml:lang="en">Diagnostic tests, such as PCR and culture, are utilized in pigs, poultry, and cattle to identify and analyze pathogens, aiding in disease detection and management.</rdfs:comment>
        <rdfs:label xml:lang="en">DiagnosticTest</rdfs:label>
        <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_16712"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Egglaying -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Egglaying">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Breed"/>
        <rdfs:comment>Egg-laying breed refers to a type of poultry, for example chickens, that is specifically raised for producing a high number of eggs.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#FarmIdentification -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#FarmIdentification">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <rdfs:comment xml:lang="en">Farm identification involves assigning a unique code or name to a specific agricultural property, facilitating tracking and management for regulatory, organizational, or administrative purposes.</rdfs:comment>
        <rdfs:label xml:lang="en">FarmIdentification</rdfs:label>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#FarmType -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#FarmType">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <rdfs:comment xml:lang="en">FarmType categorizes the nature or focus of a farm, specifying whether it is oriented towards crop cultivation, livestock raising, or a combination of both, providing a classification for agricultural purposes.</rdfs:comment>
        <rdfs:label xml:lang="en">FarmType</rdfs:label>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Feces -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Feces">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide#SampleType"/>
        <rdfs:comment>A sample of solid waste (stool) used to detect gastrointestinal pathogens, parasites, or digestive disorders.</rdfs:comment>
        <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_2772"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#FeedLot -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#FeedLot">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#FarmType"/>
        <rdfs:comment xml:lang="en">A Feedlot typically emphasizes the finishing stage of livestock for meat production,</rdfs:comment>
        <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_2842"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Finishing -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Finishing">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PigProductionStages"/>
        <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_2817"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Fluid -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Fluid">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide#SampleType"/>
        <rdfs:comment>A general term for bodily fluids (e.g., urine, pleural fluid, synovial fluid) used to test for infections or other abnormalities.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CattleGrowing -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CattleGrowing">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CattleProductionStages"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#hasBreed"/>
                <owl:allValuesFrom rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Beef"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Growing is an intermediate stage of beef cattle production, occurring after weaning and before finishing, during which animals continue to gain weight and develop.</rdfs:comment>
        <rdfs:label xml:lang="en">CattleGrowing</rdfs:label>
    </owl:Class>



    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CattleSuckling -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CattleSuckling">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CattleProductionStages"/>
        <rdfs:comment>The suckling stage refers to the period during which a calf remains with and nurses from its dam prior to weaning.</rdfs:comment>
        <rdfs:label xml:lang="en">CattleSuckling</rdfs:label>
        <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_7493"/>
    </owl:Class>



    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CattleWeaning -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CattleWeaning">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CattleProductionStages"/>
        <rdfs:comment>Weaning is the stage at which a calf is separated from its dam and transitions from nursing to independent feeding.</rdfs:comment>
        <rdfs:label xml:lang="en">CattleWeaning</rdfs:label>
        <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_15291"/>
    </owl:Class>



    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#CattleFinishing -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CattleFinishing">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CattleProductionStages"/>
        <rdfs:comment>Finishing is the final production stage in which cattle are fed to reach market weight prior to slaughter.</rdfs:comment>
        <rdfs:label xml:lang="en">CattleFinishing</rdfs:label>
        <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_2817"/>
    </owl:Class>



    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#H1N1 -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#H1N1">
        <rdfs:subClassOf rdf:resource="http://aims.fao.org/aos/agrovoc/c_6214dcad"/>
        <rdfs:comment xml:lang="en">H1N1 is a subtype of the influenza a virus, and it has been responsible for influenza outbreaks in both humans and pigs. In the context of livestock health ontology or any ontology dealing with diseases, H1N1 would be classified as a pathogen.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#H1N2 -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#H1N2">
        <rdfs:subClassOf rdf:resource="http://aims.fao.org/aos/agrovoc/c_6214dcad"/>
        <rdfs:comment>H1N2 is a swine influenza subtype, resulting from the reassortment of genetic material from human, swine, and avian influenza viruses.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#H3N2 -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#H3N2">
        <rdfs:subClassOf rdf:resource="http://aims.fao.org/aos/agrovoc/c_6214dcad"/>
        <rdfs:comment xml:lang="en">H3N2 is a subtype of the influenza a virus</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Hatching -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Hatching">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PoultryProductionStages"/>
        <rdfs:comment>Fertilized eggs are incubated under controlled conditions until chicks hatch, usually in 21 days.</rdfs:comment>
        <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_3504"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#LabReference -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LabReference">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <rdfs:comment xml:lang="en">Lab reference, often a unique number, is assigned to data related to farm animals for identification and tracking within a laboratory or data system.</rdfs:comment>
        <rdfs:label xml:lang="en">LabReference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Layer -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Layer">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PoultryProductionStages"/>
        <rdfs:comment>Pullets (young hens) are raised to become layers, producing eggs regularly starting around 18–20 weeks.</rdfs:comment>
        <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_12109"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <hasExactSynonym xml:lang="en">LHO</hasExactSynonym>
        <rdfs:comment xml:lang="en">The Live Stock Health Ontology (LHO), an extension of the DECIDE ontology, serves as a structured framework for organizing information related to the health and well-being of livestock species, encompassing cattle, poultry, pig, and salmon.

LHO facilitates the integration of domain knowledge and data, offering explicit representations of various aspects. In the development process, insights from domain experts contribute to the creation of a prototype designed for reasoning and planning of data, particularly concerning cattle.

Within LHO, concepts include farms with identifications, samples, geolocation, breed, diagnostic tests, and pathogen identifications. Notably, specific bacteria like Histophilus somni (HS), Mannheimia haemolytica (MH), Pasteurella multocida (PM), Bovine coronavirus (BCV), bacterial mycoplasma, and aerobic culture results for the respiratory tract in cattle are covered.

For pigs, additional details encompass FarmType, age, weight-related information, and pathogen names such as Porcine Reproductive and Respiratory Syndrome (PRRS), Swine Infuenza(SI), and Mycoplasma hyopneumoniae are included. This enhanced representation facilitates a comprehensive understanding of pig health, covering aspects of farm classification, age or weight specifics, and the presence of specific pathogens.

Similarly, for poultry, LHO incorporates FarmType along with specific pathogen names like Infectious Bronchitis (IB), offering a detailed perspective on poultry health, including farm categorization and information on prevalent diseases.</rdfs:comment>
        <rdfs:label xml:lang="en">LivestockHealthOntology</rdfs:label>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockProductionStages -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockProductionStages">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <rdfs:comment>Livestock production stages are the sequential phases in the life and management of farm animals, including breeding, birth, suckling, weaning, growing, finishing, and reproduction.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#LocalAuthority -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LocalAuthority">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C25341"/>
        <NCIT:IAO_0000112>For example for Scotland local authority council example areas are Highland, Argyll and Bute, or Glasgow City etc...</NCIT:IAO_0000112>
        <rdfs:comment>An administrative council area that governs and delivers public services for a defined local community region.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Month -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Month">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#TimeUnit"/>
        <rdfs:comment>A time unit based on calendar months, typically used for monthly reporting or trends.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Mortality -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Mortality">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <rdfs:comment>Mortality represents the death of one or more individuals in a given animal population, often measured over a specified time frame, due to natural causes, disease, management practices, or environmental factors.</rdfs:comment>
        <rdfs:label>Mortality</rdfs:label>
        <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_4945"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Nursery -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Nursery">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PigProductionStages"/>
        <rdfs:comment>Nursery stage is the post-weaning phase (4–10 weeks) where piglets are housed separately, given special feed, and undergo rapid growth, socialization, and health care.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#PigProductionStages -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PigProductionStages">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockProductionStages"/>
        <rdfs:comment>Pig production stages focused on growth and productivity</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#PigSample -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PigSample">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:comment xml:lang="en">PigSample is n number of observations for Pig and piglets</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#PoultryProductionStages -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PoultryProductionStages">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockProductionStages"/>
        <rdfs:comment>Poultry production stages are the key phases in the lifecycle and management of birds raised for eggs or meat, including breeding, hatching, growing, laying, and processing.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#PoultrySample -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PoultrySample">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide#Sample"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS31"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS28"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">PoultrySample is &quot;n&quot; number of observation for Poultry data.</rdfs:comment>
        <rdfs:comment xml:lang="en">PoultrySample is associated with a specific flock, linking pathogen data, diagnostic tests, and geolocation.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Processing -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Processing">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PoultryProductionStages"/>
        <rdfs:comment>Mature birds are slaughtered, cleaned, and prepared for meat production or market.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Province -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Province">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C25341"/>
        <rdfs:comment xml:lang="en">A province is an administrative region or territorial division within a country, typically with its own government and administrative structure.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Salmon -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Salmon">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Species"/>
        <NCIT:IAO_0000112>Atlantic salmon (Salmo salar) are frequently farmed in marine cages and monitored for growth, health, and disease events such as sea lice infestation or viral infections.</NCIT:IAO_0000112>
        <NCIT:IAO_0000118>Atlantic salmon
Pacific salmon</NCIT:IAO_0000118>
        <NCIT:IAO_0000412>https://agrovoc.fao.org/browse/agrovoc/en/page/c_6756</NCIT:IAO_0000412>
        <rdfs:comment>A common name for several species of ray-finned fish in the family Salmonidae, widely farmed in aquaculture systems for food production. Salmon are anadromous, meaning they hatch in freshwater, migrate to the ocean, and return to freshwater to spawn.</rdfs:comment>
        <rdfs:label>Salmon</rdfs:label>
        <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_6756"/>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_8030"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#SalmonSample -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#SalmonSample">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide#Sample"/>
        <NCIT:IAO_0000112>SalmonSample is &quot;n&quot; number of observation for Salmon data.</NCIT:IAO_0000112>
        <rdfs:comment>A SalmonSample represents a biological sample collected from a salmon individual, associated with pathogen detection, diagnostic tests, and location data, Mortality rate, actual biomass and water type.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#SampleNumber -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#SampleNumber">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <rdfs:comment xml:lang="en">SampleNumber is a unique identifier assigned to a specimen collected from livestock or other sources for purposes such as diagnostics or research, facilitating individual sample tracking and data organization.</rdfs:comment>
        <rdfs:label xml:lang="en">SampleNumber</rdfs:label>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#SlaughterEvent -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#SlaughterEvent">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide#EventType"/>
        <rdfs:comment>Slaughter event refers to the process of killing animals, usually for meat production or other purposes.</rdfs:comment>
        <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_7107"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Species -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Species">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <rdfs:comment xml:lang="en">Cattle, pig, poultry, and salmon represent distinct species within the animal kingdom commonly raised for agricultural or aquacultural purposes, including meat production.</rdfs:comment>
        <rdfs:comment xml:lang="en">Livestock species classification</rdfs:comment>
        <rdfs:label xml:lang="en">Species</rdfs:label>
        <owl:equivalentClass xml:lang="en">http://www.purl.org/decide#SpeciesGroup</owl:equivalentClass>
        <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_7280"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Suckling -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Suckling">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PigProductionStages"/>
        <rdfs:comment>Suckling stage begins at birth and lasts for about 21–28 days (3–4 weeks), during which piglets nurse from the sow.
They are born small (2–3 pounds), blind, and hairless but quickly develop eyesight, teeth, and mobility.
By around 3 weeks, they begin nibbling on solid feed alongside milk as they prepare for weaning.</rdfs:comment>
        <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_7493"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Swab -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Swab">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide#SampleType"/>
        <rdfs:comment xml:lang="en">A swab is a sample collection method involving a small absorbent tool, often a cotton-tipped applicator, used to collect specimens from surfaces or body areas, such as the throat or nasal cavity, for diagnostic or research purposes.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#TimeUnit -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#TimeUnit">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide#Unit"/>
        <rdfs:comment>Measuring time</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Tissue -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Tissue">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide#SampleType"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#VaccinationEvent -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#VaccinationEvent">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide#EventType"/>
        <rdfs:comment>Vaccination event refers to the process of giving vaccines to individuals or animals to protect them from specific diseases.</rdfs:comment>
        <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_15123"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#WaterType -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#WaterType">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#LivestockHealthOntology"/>
        <rdfs:comment>In aquaculture (fish farming, like salmon farming), WaterType refers to the kind of water environment (freshwater, seawater, or brackish)  the animals are raised in.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Weaning -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Weaning">
