    <owl:NamedIndividual rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#SeaLice">
        <rdf:type rdf:resource="http://aims.fao.org/aos/agrovoc/c_26545"/>
        <affectsSpecies rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Salmon"/>
        <hasExactSynonym xml:lang="en">sea lice</hasExactSynonym>
        <hasExactSynonym xml:lang="en">salmon louse</hasExactSynonym>
        <rdfs:comment xml:lang="en">Sea lice (Lepeophtheirus salmonis), a parasitic copepod of farmed Atlantic salmon.</rdfs:comment>
        <rdfs:label xml:lang="en">Lepeophtheirus salmonis</rdfs:label>
        <causesDisease rdf:resource="http://opendata.inra.fr/AHOL/AHOL_0005014"/>
