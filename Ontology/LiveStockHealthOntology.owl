        <rdfs:isDefinedBy>http://opendata.inrae.fr/AHOL/AHOL_0005014</rdfs:isDefinedBy>
        <rdfs:comment xml:lang="en">A disease caused by a parasite, for example sea lice infestation in farmed salmon.</rdfs:comment>
        <rdfs:label xml:lang="en">Parasitic Disease</rdfs:label>
    </owl:Class>
    


