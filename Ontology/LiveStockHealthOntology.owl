        <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_15846"/>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#WeightUnit -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#WeightUnit">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide#Unit"/>
        <rdfs:comment>A measurement unit used to quantify mass or weight, such as grams, kilograms, or pounds.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Year -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Year">
