    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Breeder"/>
            <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Broiler"/>
            <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Hatching"/>
            <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Layer"/>
            <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Processing"/>
        </owl:members>
    </rdf:Description>
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Breeding"/>
            <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Finishing"/>
            <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Nursery"/>
            <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Suckling"/>
            <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Weaning"/>
        </owl:members>
    </rdf:Description>
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CattleProductionStages"/>
            <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PigProductionStages"/>
            <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PoultryProductionStages"/>
        </owl:members>
    </rdf:Description>

    <!-- Added 15 Oct 2026: pathogen groups, Lawsonia intracellularis, sea lice, Salmon species, SKOS mapping properties -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/isReplacedBy"/>
    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch"/>

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#closeMatch"/>



    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#PathogenicBacterium -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PathogenicBacterium">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide#Pathogen"/>
        <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_34317"/>
        <rdfs:comment xml:lang="en">A bacterium that causes disease in its host.</rdfs:comment>
        <rdfs:label xml:lang="en">PathogenicBacterium</rdfs:label>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#PathogenicVirus -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PathogenicVirus">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide#Pathogen"/>
        <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_34318"/>
        <rdfs:comment xml:lang="en">A virus that causes disease in its host.</rdfs:comment>
        <rdfs:label xml:lang="en">PathogenicVirus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.purl.org/decide/LiveStockHealthOnto/LHO#Parasite -->

    <owl:Class rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Parasite">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide#Pathogen"/>
        <skos:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_5574"/>
        <rdfs:comment xml:lang="en">An organism that lives on or in a host and causes disease or harm to it, such as sea lice in farmed salmon.</rdfs:comment>
        <rdfs:label xml:lang="en">Parasite</rdfs:label>
    </owl:Class>
    


    <!-- http://aims.fao.org/aos/agrovoc/c_36450 -->

    <owl:Class rdf:about="http://aims.fao.org/aos/agrovoc/c_36450">
        <rdfs:subClassOf rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#PathogenicBacterium"/>
        <NCIT:IAO_0000412>https://agrovoc.fao.org/browse/agrovoc/en/</NCIT:IAO_0000412>
        <rdfs:isDefinedBy>https://agrovoc.fao.org/browse/agrovoc/en/page/c_36450</rdfs:isDefinedBy>
        <rdfs:comment xml:lang="en">Lawsonia intracellularis is an obligate intracellular bacterium causing proliferative enteropathy (ileitis) in pigs.</rdfs:comment>
        <rdfs:label xml:lang="en">LawsoniaIntracellularis</rdfs:label>
    </owl:Class>
    


