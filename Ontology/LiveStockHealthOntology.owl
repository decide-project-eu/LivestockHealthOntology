    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotations
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <rdf:Description rdf:about="http://opendata.inra.fr/AHOL/AHOL_0005015">
        <NCIT:IAO_0000412>https://bioportal.bioontology.org/ontologies/AHOL?p=summary</NCIT:IAO_0000412>
        <rdfs:comment>Viral disease is an illness caused by a virus, where the virus invades living cells to reproduce, often leading to symptoms like fever, cough, or organ damage.</rdfs:comment>
        <rdfs:label>Viral Disease</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://opendata.inra.fr/AHOL/AHOL_0005012">
        <rdfs:comment xml:lang="en">Bacterial disease is an illness caused by pathogenic bacteria, such as Mannheimia haemolytica, Pasteurella multocida, Histophilus somni, or Mycoplasma bovis in cattle.</rdfs:comment>
        <rdfs:label xml:lang="en">Bacterial Disease</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Autopsy">
        <rdfs:comment xml:lang="en">An autopsy sample refers to tissues or specimens collected during a post-mortem examination, conducted to investigate the cause of death or study pathological conditions in animals or humans.</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#BAL">
        <rdfs:comment>Bronchoalveolar Lavage is a fluid sample collected from the lungs by flushing and retrieving liquid through a bronchoscope to examine respiratory infections.</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Broiler">
        <rdfs:comment>Chicks raised specifically for meat production grow rapidly and are typically processed within 6–8 weeks.</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#CS76">
        <rdfs:comment>Mixed breed cattle are crossbred animals that do not belong to a single pure breed category. May include dairy-beef crosses or other hybrid breeding combinations</rdfs:comment>
        <rdfs:label>Mixed</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Dairy">
        <rdfs:comment>Dairy breed refers to a type of livestock, for example cows, that is specifically raised for milk production</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Finishing">
        <rdfs:comment>Finishing stage in pigs is the final growth phase, typically from 10 to 25 weeks of age, where pigs grow from about 20–25 kg to 100–110+ kg before market.</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Tissue">
        <rdfs:comment xml:lang="en">A tissue sample is a specimen composed of cells derived from an organism&apos;s body, collected for diagnostic or research purposes to study cellular structures, functions, or identify potential abnormalities.</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Weaning">
        <rdfs:comment>Weaning stage (4–8 weeks) is when piglets are separated from the sow and transition fully to solid food, ending milk consumption.</rdfs:comment>
    </rdf:Description>
    


