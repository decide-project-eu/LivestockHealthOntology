        <affectsSpecies rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Cattle"/>
        <hasExactSynonym xml:lang="en">Nasopharyngeal Swab</hasExactSynonym>
        <rdfs:comment>Nasopharyngeal Swab (NPS) is a sample collection method where a swab is inserted through the nostril to collect secretions from the nasopharynx. Commonly used for detecting respiratory pathogens</rdfs:comment>
