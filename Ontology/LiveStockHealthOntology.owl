        <affectsSpecies rdf:resource="http://www.purl.org/decide/LiveStockHealthOnto/LHO#Cattle"/>
        <hasExactSynonym>Trans-tracheal Aspirate (TTA)</hasExactSynonym>
        <rdfs:comment>Trans-tracheal Aspirate (TTA) is a diagnostic sample collected by inserting a catheter through the trachea to obtain lower respiratory tract secretions. Used for accurate identification of bacterial pathogens</rdfs:comment>
        <rdfs:label xml:lang="en">TTA</rdfs:label>
    </owl:NamedIndividual>
    


